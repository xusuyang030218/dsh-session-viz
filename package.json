{
  "name": "dsh-session-viz",
  "version": "1.0.0",
  "description": "AgentTrace 智能体轨迹：DSH 会话日志可视化插件——三层渐进式查看器（摘要/故事线/事件树）+ 四层进度体系。host 半 TypeScript（tsdown 构建），随 harness 启动。",
  "type": "module",
  "main": "lib/host/index.mjs",
  "exports": {
    ".": "./lib/host/index.mjs",
    "./web": "./lib/host/web.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "session",
    "log",
    "visualizer",
    "timeline",
    "jsonl"
  ],
  "scripts": {
    "build": "pnpm exec tsdown -c tsdown.config.ts && node scripts/verify-build.mjs",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "node run_tests.py"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
